# name: test/sql/composed.test
# description: Composed examples -- functions feeding each other (country_code + distance_km over a trace, reverse_geocode + distance_km, timezone + DuckDB timezone(), country_code + timezone aggregate)
# group: [vgi_geocode]

require-env VGI_GEOCODE_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'geocode' AS geocode (TYPE vgi, LOCATION '{VGI_GEOCODE_WORKER}');

# Border-crossing legs of a Paris -> Lyon -> Geneva -> Zurich -> Milan trace
# (the published COMPOSED_TRACE_BORDER_LEGS example).
query ITTRT
WITH trace AS (SELECT * FROM (VALUES (1, 48.8566, 2.3522), (2, 45.7640, 4.8357), (3, 46.2044, 6.1432),
  (4, 47.3769, 8.5417), (5, 45.4642, 9.1900)) AS t(seq, lat, lon)),
legs AS (SELECT seq, lag(lat) OVER w AS prev_lat, lag(lon) OVER w AS prev_lon, lat, lon
  FROM trace WINDOW w AS (ORDER BY seq))
SELECT seq, geocode.main.country_code(prev_lat, prev_lon) AS from_country,
  geocode.main.country_code(lat, lon) AS to_country,
  round(geocode.main.distance_km(prev_lat, prev_lon, lat, lon)) AS leg_km,
  from_country <> to_country AS crosses_border
FROM legs WHERE prev_lat IS NOT NULL ORDER BY seq;
----
2	FR	FR	391.0	false
3	FR	CH	112.0	true
4	CH	CH	224.0	false
5	CH	IT	218.0	true

# Distance from a query point to its matched GeoNames place: an ocean point is far
# from its label, a city-centre point is close.
query TT
SELECT name, geocode.main.distance_km(lat, lon, p.place_lat, p.place_lon) > 500 AS far_from_label
FROM (SELECT name, lat, lon, geocode.main.reverse_geocode(lat, lon) AS p
  FROM (VALUES ('Times Square', 40.7580, -73.9855), ('Mid-Atlantic', 35.0, -40.0)) AS t(name, lat, lon))
ORDER BY name;
----
Mid-Atlantic	true
Times Square	false

# timezone() output feeds DuckDB's timezone(zone, ts) to localize UTC timestamps.
query IT
SELECT event_id, timezone(geocode.main.timezone(lat, lon), ts_utc) AS local_time
FROM (VALUES (1, 40.7128, -74.0060, TIMESTAMPTZ '2026-03-01 14:00:00+00'),
  (2, 35.6762, 139.6503, TIMESTAMPTZ '2026-03-01 14:00:00+00'),
  (3, 51.5074, -0.1278, TIMESTAMPTZ '2026-07-01 14:00:00+00')) AS t(event_id, lat, lon, ts_utc)
ORDER BY event_id;
----
1	2026-03-01 09:00:00
2	2026-03-01 23:00:00
3	2026-07-01 15:00:00

# Agent task border_crossing_trace_km: AT->SK + SK->HU + HU->RS legs = 381 km.
query I
WITH trace AS (SELECT * FROM (VALUES (1, 48.2082, 16.3738), (2, 48.1486, 17.1077),
  (3, 47.4979, 19.0402), (4, 46.2530, 20.1414), (5, 44.7866, 20.4489)) AS t(seq, lat, lon)),
legs AS (SELECT lag(lat) OVER w AS plat, lag(lon) OVER w AS plon, lat, lon
  FROM trace WINDOW w AS (ORDER BY seq))
SELECT CAST(round(sum(geocode.main.distance_km(plat, plon, lat, lon))) AS INTEGER) AS total_km
FROM legs
WHERE plat IS NOT NULL
  AND geocode.main.country_code(plat, plon) <> geocode.main.country_code(lat, lon);
----
381

# Agent task timezones_per_country: distinct IANA zones per reverse-geocoded country.
query TI
SELECT geocode.main.country_code(lat, lon) AS country_code,
  count(DISTINCT geocode.main.timezone(lat, lon)) AS n_timezones
FROM (VALUES (40.7128, -74.0060), (34.0522, -118.2437), (41.8781, -87.6298), (48.8566, 2.3522),
  (45.7640, 4.8357), (-33.8688, 151.2093), (-31.9505, 115.8605)) AS t(lat, lon)
GROUP BY country_code ORDER BY country_code;
----
AU	2
FR	1
US	3
